a^b

a^b mod m

Huge power

Complexity

O(log b)
long long binpow(long long a,long long b){
    long long res=1;
    while(b){
        if(b&1) res*=a;
        a*=a;
        b>>=1;
    }
    return res;
}

Modulo

long long modpow(long long a,long long b,long long mod){
    long long res=1;
    a%=mod;

    while(b){

        if(b&1)
            res=res*a%mod;

        a=a*a%mod;

        b>>=1;
    }

    return res;
}
