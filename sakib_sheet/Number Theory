const int N=1e7+5;

vector<int> primes;
int lp[N];

void linear_sieve(){

    for(int i=2;i<N;i++){

        if(lp[i]==0){

            lp[i]=i;

            primes.push_back(i);

        }

        for(int p:primes){

            if(p>lp[i] || 1LL*i*p>=N)

                break;

            lp[i*p]=p;

        }
    }
}

