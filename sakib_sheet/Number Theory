vector<pair<long long,int>> factor(long long n){

    vector<pair<long long,int>> f;

    for(long long i=2;i*i<=n;i++){

        if(n%i==0){

            int cnt=0;

            while(n%i==0){

                cnt++;

                n/=i;

            }

            f.push_back({i,cnt});

        }
    }

    if(n>1)

        f.push_back({n,1});

    return f;
}

