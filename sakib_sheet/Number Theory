vector<bool> segmented(long long L,long long R){

    vector<bool> isPrime(R-L+1,true);

    for(long long p:primes){

        if(1LL*p*p>R)

            break;

        long long start=max(1LL*p*p,((L+p-1)/p)*1LL*p);

        for(long long j=start;j<=R;j+=p)

            isPrime[j-L]=false;
    }

    if(L==1)

        isPrime[0]=false;

    return isPrime;
}

